[TEMPLATE]
# ---- Rename this file to .env before running locally ----
# ---- On Render, you paste these into the "Environment" tab instead ----

PORT=10000

# IntaSend - the SOLE payment provider (M-Pesa, cards, bank transfers).
# Get these from https://sandbox.intasend.com (test) or https://intasend.com (live)
# -> Settings -> API Keys. Individual accounts are accepted; complete KYC in
# the dashboard to switch from test to live keys.
INTASEND_PUBLIC_KEY=your_intasend_publishable_key_here
INTASEND_SECRET_KEY=your_intasend_secret_key_here
INTASEND_ENV=sandbox
# Must be your live app URL (IntaSend redirects the customer back here after paying)
INTASEND_REDIRECT_URL=https://your-app-name.onrender.com/

# Price per download, in Kenyan Shillings (also the checkout currency)
PRICE_KES=20

# User accounts - MongoDB Atlas (free tier). Get a connection string from
# https://cloud.mongodb.com -> Database -> Connect -> "Drivers"
# Looks like: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/kdocspro
# Payment records are stored here too, so they survive restarts.
MONGODB_URI=your_mongodb_connection_string_here

# Any long random string - used to sign login sessions. Generate one at
# https://www.random.org/strings/ or just mash your keyboard for 40+ characters.
JWT_SECRET=change_this_to_a_long_random_string

# Google sign-in (optional) - from https://console.cloud.google.com
# -> APIs & Services -> Credentials -> Create OAuth Client ID (type: Web application)
# Leave blank and the app simply won't show the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# Optional: comma-separated list of extra allowed origins for the API.
# Leave blank for same-origin only (the normal case when this same app
# serves the frontend).
CORS_ORIGINS=
