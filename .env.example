# ---- Rename this file to .env before running locally ----
# ---- On Render, you paste these into the "Environment" tab instead ----

PORT=10000

# Daraja (M-Pesa) credentials - get these from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_passkey_here
DARAJA_ENV=sandbox
# This must be your live Render URL + /api/daraja/callback once deployed
DARAJA_CALLBACK_URL=https://your-app-name.onrender.com/api/daraja/callback

# Price per download, in Kenyan Shillings
PRICE_KES=20

# IntaSend (adds card, bank transfer, and other mobile money on top of M-Pesa)
# Get these from https://sandbox.intasend.com (test) or https://intasend.com (live)
# -> Settings -> API Keys. Set your payout/settlement bank account under
# Settings -> Payment Preferences / Settlements in the IntaSend dashboard.
INTASEND_PUBLIC_KEY=your_intasend_publishable_key_here
INTASEND_SECRET_KEY=your_intasend_secret_key_here
INTASEND_ENV=sandbox
# Must be your live Render URL (IntaSend redirects the customer back here after paying)
INTASEND_REDIRECT_URL=https://your-app-name.onrender.com/
